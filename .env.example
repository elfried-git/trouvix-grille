# Trouvix Grille — Environment Variables
# Copy this file to .env.local for local development
# Set these in Vercel dashboard > Settings > Environment Variables for production

# URL of the game-service (Socket.io server)
# Local dev: not needed (uses Caddy gateway automatically)
# Production: set to your Cloudflare Worker URL
# Example: https://trouvix-game-service.trouvix-grille.workers.dev
NEXT_PUBLIC_GAME_SERVICE_URL=

# Secret PIN for Benchou Ferrari identification (set on the game-service, not Vercel)
# Override the default 331991 in production for security
# Set this as a Cloudflare Worker secret with: npx wrangler secret put BENCHOU_PIN
