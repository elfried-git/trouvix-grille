{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trouvix-game-service",
  "main": "mini-services/game-service/worker.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "GameCoordinatorV2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameCoordinator"]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "GameCoordinator",
          "to": "GameCoordinatorV2"
        }
      ]
    }
  ],
  "vars": {
    "APP_URL": "https://trouvix-grille.vercel.app"
  }
}
