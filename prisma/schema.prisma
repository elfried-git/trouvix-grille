// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Card {
  id        String   @id @default(cuid())
  category  String
  prompt    String
  answer    String?
  points    Int
  createdAt DateTime @default(now())

  @@index([category])
}

model GameResult {
  id        String   @id @default(cuid())
  winnerName String
  winnerScore Int
  players   String
  durationMin Int
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  authorName String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}