// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Card {
  id        String   @id @default(cuid())
  category  String   // "couple" | "culture" | "defi" | "souvenir" | "surprise"
  prompt    String   // The question / challenge text
  answer    String?  // Optional answer (for culture trivia)
  points    Int      // Points awarded on success
  createdAt DateTime @default(now())

  @@index([category])
}

model GameResult {
  id        String   @id @default(cuid())
  winnerName String
  winnerScore Int
  players   String   // JSON string of players summary
  durationMin Int
  createdAt DateTime @default(now())
}

model Review {
  id          String    @id @default(cuid())
  name        String    // reviewer's display name
  rating      Int       // 1-5 stars
  comment     String    // text comment
  status      String    @default("pending") // "pending" | "approved" | "rejected"
  adminNote   String?   // optional note from Benchou when rejecting
  createdAt   DateTime  @default(now())
  validatedAt DateTime?

  @@index([status])
  @@index([createdAt])
}